LAGO_DOMAIN=
LAGO_ACME_EMAIL=
PORTAINER_USER=
PORTAINER_PASSWORD=

# --- ERP single-login (optional; default OFF = upstream Lago behavior) -------
# Set these only when fronting Lago behind the ERP SSO gateway. See deploy/ERP-SSO.md.
# LAGO_ERP_SSO_STRICT=true
# KEYCLOAK_ISSUER=https://keycloak.gridironrobotics.com/realms/erp
# KEYCLOAK_JWKS_URL=https://keycloak.gridironrobotics.com/realms/erp/protocol/openid-connect/certs
# KEYCLOAK_AUDIENCE=account
# ERP_DASHBOARD_URL=https://dashboard.gridironrobotics.com
