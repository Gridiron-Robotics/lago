LAGO_DOMAIN=
LAGO_ACME_EMAIL=
PORTAINER_USER=
PORTAINER_PASSWORD=

# --- ERP single-login (optional; default OFF = upstream Lago behavior) -------
# Set these only when fronting Lago behind the ERP SSO gateway. See deploy/ERP-SSO.md.
# LAGO_ERP_SSO_STRICT=true
# KEYCLOAK_ISSUER=https://keycloak.gridironrobotics.com/realms/erp
# KEYCLOAK_JWKS_URL=https://keycloak.gridironrobotics.com/realms/erp/protocol/openid-connect/certs
# KEYCLOAK_AUDIENCE=account
# ERP_DASHBOARD_URL=https://dashboard.gridironrobotics.com

# --- MCP sidecar (lago-mcp) -------------------------------------------------
# The Contract A surface the ERP brain dials as `lago-mcp:8037`. It joins
# erp_shared_network, which must already exist on the host:
#   docker network create erp_shared_network
#
# Bearer the brain presents, verified constant-time at the boundary. Leave it
# empty and the sidecar fails CLOSED: every tool route answers 503 naming this
# variable, rather than serving billing data to anything that reaches the port.
# It must match the brain's GATEWAY_TOKENS entry for the `lago` server.
LAGO_MCP_TOKEN=
# Downstream Lago organisation API key the sidecar fronts. Empty => the 4
# money-moving write tools are not registered at all and only the 6 read tools
# are advertised. Never commit a real value.
LAGO_MCP_LAGO_API_KEY=
