# ERP single-login overrides for Lago (default stack is unchanged without these).
# Include alongside deploy/.env.production:
#   docker compose --env-file deploy/.env.production --env-file deploy/.env.erp-sso \
#     -f deploy/docker-compose.production.yml up -d
# See deploy/ERP-SSO.md for the matching lago-api / lago-front fork changes.
LAGO_ERP_SSO_STRICT=true
KEYCLOAK_ISSUER=https://keycloak.gridironrobotics.com/realms/erp
KEYCLOAK_JWKS_URL=https://keycloak.gridironrobotics.com/realms/erp/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=account
ERP_DASHBOARD_URL=https://dashboard.gridironrobotics.com
